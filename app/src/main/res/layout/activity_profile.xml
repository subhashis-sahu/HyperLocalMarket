<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:id="@+id/main"
    android:scrollbars="none">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        >


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/profile_hero_bg"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Top bar: Back  |  Help  More -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:src="@drawable/arrow_back_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:tint="@android:color/black"
                    android:padding="8dp" />

                <!-- spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Help pill button -->
                <TextView
                    android:id="@+id/btnHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/help_pill_bg"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Help"
                    android:textColor="#6366F1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- More (⋮) -->
                <ImageView
                    android:src="@drawable/more_vert_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    android:id="@+id/btnMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:tint="@android:color/black"
                    android:layout_marginStart="4dp"
                    android:padding="8dp"
                    />
            </LinearLayout>

            <!-- User name + phone -->
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:text="Subhashis Sahu"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvUserPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="+91 – 70087 26013"
                android:textColor="#64748B"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ══════════════════════════════════
             MEMBERSHIP BANNER CARD
             ══════════════════════════════════ -->


        <!-- ══════════════════════════════════
             QUICK ACTION TILES  (2×2 grid)
             ══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Saved Address -->
            <LinearLayout
                android:id="@+id/tileSavedAddress"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/card_white_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/location"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Saved\nAddress"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Payment Modes -->
            <LinearLayout
                android:id="@+id/tilePayment"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/card_white_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/payments_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Payment\nModes"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- My Refunds -->
            <LinearLayout
                android:id="@+id/tileRefunds"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/card_white_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/rewards"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="My\nRefunds"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Marketplace Money / Wallet -->
            <LinearLayout
                android:id="@+id/tileWallet"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/card_white_rounded"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/money_bag_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="My\nWallet"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════
             MENU LIST CARD
             ══════════════════════════════════ -->
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_white_rounded"
            android:elevation="1dp"

            android:orientation="vertical">


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="#F1F5F9" />

            <!-- Row: Account Statements -->
            <LinearLayout
                android:id="@+id/rowStatements"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/receipt"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Account Statements"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="#C7C7C7" />

            <!-- Row: Corporate Rewards -->
            <LinearLayout
                android:id="@+id/rowCorporate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:tint="@android:color/black"
                    android:src="@drawable/work_24dp_e3e3e3_fill0_wght400_grad0_opsz24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Corporate Rewards"

                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="#C7C7C7" />

            <!-- Row: Student Rewards -->
            <LinearLayout
                android:id="@+id/rowStudent"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/rewarded_ads_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    app:tint="@android:color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Student Rewards"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                     />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="56dp" android:background="#C7C7C7" />

            <!-- Row: My Wishlist -->
            <LinearLayout
                android:id="@+id/rowWishlist"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="5dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/favorite_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    app:tint="@android:color/black"
                    />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="My Wishlist"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    />
            </LinearLayout>
            <View

                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="56dp" android:background="#C7C7C7" />
            <LinearLayout
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="5dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/favorite_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                    app:tint="@android:color/black"
                    />

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Logout"
                    android:textColor="#0F172A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="56dp" android:background="#F1F5F9" />

            <!-- Row: Partner Rewards -->


        </LinearLayout>



    </LinearLayout>
</ScrollView>
