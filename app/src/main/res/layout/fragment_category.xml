<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CategoryFragment">

    <LinearLayout
        android:layout_marginBottom="56dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/arrow_back_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                android:contentDescription="Back"
                app:tint="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Categories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E9E9E9"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <!-- LEFT CATEGORY PANEL -->
            <ScrollView

                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:background="#F8FAFC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="20dp">

                    <!-- Real Estate -->
                    <LinearLayout
                        android:id="@+id/realEstate"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/apartment_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Real Estate"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Furniture -->
                    <LinearLayout
                        android:id="@+id/furniture"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/chair_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Furniture"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Cars -->
                    <LinearLayout
                        android:id="@+id/cars"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/car_rental_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Cars"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Bikes -->
                    <LinearLayout
                        android:id="@+id/bikes"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/two_wheeler_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Bikes"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Electronics -->
                    <LinearLayout
                        android:id="@+id/electronics"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/air_purifier_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Electronics"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Books -->
                    <LinearLayout
                        android:id="@+id/books"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/book_ribbon_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Books"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Computers -->
                    <LinearLayout
                        android:id="@+id/computers"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/computer_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Computers"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Gaming -->
                    <LinearLayout
                        android:id="@+id/gaming"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/sports_cricket_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Gaming"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Appliances -->
                    <LinearLayout
                        android:id="@+id/appliances"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ac_unit_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Appliances"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sports -->
                    <LinearLayout
                        android:id="@+id/sports"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/stadia_controller_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Sports"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Others -->
                    <LinearLayout
                        android:id="@+id/others"
                        android:layout_width="96dp"
                        android:layout_height="90dp"
                        android:background="@drawable/category_chip_default"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/more_horiz_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Others"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </ScrollView>


            <!-- RIGHT PRODUCT AREA -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoriesWise"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

            </FrameLayout>

        </LinearLayout>


        </LinearLayout>



</FrameLayout>