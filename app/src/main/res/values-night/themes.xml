<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.HyperLocalMarket"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorAccent">@color/accent</item>

        <!-- Dark background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- White icons on dark system bars -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Font -->
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>

    </style>


    <style name="CustomPopUpMenu"
        parent="ThemeOverlay.Material3">

        <item name="android:windowBackground">@drawable/bg_popup</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:elevation">8dp</item>
        <item name="android:textColorPrimary">@color/text_primary</item>

    </style>


    <style name="BottomNavActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">

        <item name="android:color">@android:color/transparent</item>

    </style>

</resources>